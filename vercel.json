{
  "crons": [
    {
      "path": "/api/alpha/run",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/stock/refresh",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "conviqt.com" }],
      "destination": "https://www.conviqt.com/$1",
      "permanent": true
    }
  ]
}
