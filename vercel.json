{
  "crons": [
    {
      "path": "/api/alpha/run",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/stock/refresh",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/watchlist/sweep",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cdi/publish",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/newsletter/send",
      "schedule": "0 14 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "conviqt.com" }],
      "destination": "https://www.conviqt.com/$1",
      "permanent": true
    }
  ]
}
